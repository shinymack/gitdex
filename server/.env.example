# Runtime
PORT=3001
NODE_ENV=development
CLIENT_URLS=http://localhost:3000,https://gitdex-alpha.vercel.app
# Stable public API origin. Use a reachable HTTPS tunnel for local broker delivery.
BASE_URL=

# Upstash Redis REST (not a redis:// connection)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash delivery and callback verification
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Documentation writer and shared client/API destination
GITHUB_TOKEN=
GITHUB_USERNAME=
DOCS_REPO_OWNER=
DOCS_REPO_NAME=gitdex-docs
DOCS_REPO_BRANCH=main
# Optional separate public-source metadata token; writer token is never reused.
GITHUB_SOURCE_TOKEN=

# Google provider: ordered candidates, no probe generations
GOOGLE_GENERATIVE_AI_API_KEY=
DOCS_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
CHAT_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
CHAT_TIMEOUT_MS=90000

# Pipeline bounds; keep work + 5000 strictly below both actual limits.
PIPELINE_CONCURRENCY=4
PIPELINE_STEP_DELAY_SEC=2
AI_THROTTLE_MS=2000
PIPELINE_WORK_TIMEOUT_MS=45000
FUNCTION_MAX_DURATION_MS=60000
QSTASH_RESPONSE_TIMEOUT_MS=60000
PIPELINE_RECOVERY_MS=120000
PIPELINE_DELIVERY_RETRIES=5
PIPELINE_MAX_STEP_ATTEMPTS=8
PIPELINE_MAX_DISPATCH_ATTEMPTS=12
PIPELINE_MAX_FILES=50
PIPELINE_MAX_SECTIONS=20
INDEXING_PAUSED=false

# Keep production namespace stable; unique smoke prefixes isolate verification.
PIPELINE_STATE_PREFIX=gitdex:v2:
# Explicit development-only options; administration is absent in production.
PIPELINE_LOCAL_DISPATCH=false
DEV_ADMIN_TOKEN=
DOCS_ALLOW_DESTRUCTIVE_DEV=false
